# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - AUTOTALLER SAAS (FASE 1)
# ==============================================================================

# --- BASE DE DATOS (PostgreSQL / Supabase / Prisma) ---
# Para desarrollo local rápido con SQLite:
# DATABASE_URL="file:./dev.db"

# Para conectar a Supabase PostgreSQL o PostgreSQL externo:
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@db.[TU_PROYECTO].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[TU_PASSWORD]@db.[TU_PROYECTO].supabase.co:5432/postgres"

# --- AUTENTICACIÓN & SEGURIDAD JWT ---
JWT_SECRET="super-secret-jwt-key-auto-taller-saas-2026-secure-random"

# --- OBJECT STORAGE (Supabase Storage / AWS S3) ---
# Supabase Storage para fotos de peritaje y vehículos:
NEXT_PUBLIC_SUPABASE_URL="https://[TU_PROYECTO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-de-supabase"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-de-supabase"
SUPABASE_STORAGE_BUCKET="vehicle-photos"

# AWS S3 (Opcional si se prefiere S3 en lugar de Supabase):
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- METADATOS DEL TALLER (TENANT) ---
NEXT_PUBLIC_APP_NAME="AutoTaller SaaS"
NEXT_PUBLIC_WORKSHOP_NAME="Taller Mecánico Central Pro"
NEXT_PUBLIC_WORKSHOP_PHONE="+54 9 11 4567-8900"
NEXT_PUBLIC_WORKSHOP_ADDRESS="Av. del Libertador 4580, Buenos Aires"
